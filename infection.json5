{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "app/Actions",
            "app/Services"
        ]
    },
    "phpUnit": {
        "configDir": ".",
        "customPath": "vendor/bin/pest"
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=Unit",
    "timeout": 30,
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log"
    },
    "tmpDir": "storage/infection",
    "mutators": {
        "@default": true
    }
}
